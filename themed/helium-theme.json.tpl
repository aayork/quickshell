{
  "manifest_version": 3,
  "name": "Desktop",
  "description": "Helium colours from the current desktop theme (aayork-quickshell). Generated by bin/theme-set-templates; installed by bin/theme-set-helium.",
  "version": "1.0",
  "theme": {
    "colors": {
      "frame": [{{ dark_background_rgb }}],
      "frame_inactive": [{{ dark_background_rgb }}],
      "frame_incognito": [{{ darker_background_rgb }}],
      "frame_incognito_inactive": [{{ darker_background_rgb }}],
      "background_tab": [{{ dark_background_rgb }}],
      "background_tab_inactive": [{{ dark_background_rgb }}],
      "toolbar": [{{ background_rgb }}],
      "toolbar_text": [{{ foreground_rgb }}],
      "toolbar_button_icon": [{{ foreground_rgb }}],
      "tab_text": [{{ bright_foreground_rgb }}],
      "tab_background_text": [{{ dark_foreground_rgb }}],
      "tab_background_text_inactive": [{{ dark_foreground_rgb }}],
      "bookmark_text": [{{ foreground_rgb }}],
      "omnibox_background": [{{ dark_background_rgb }}],
      "omnibox_text": [{{ foreground_rgb }}],
      "ntp_background": [{{ background_rgb }}],
      "ntp_text": [{{ foreground_rgb }}],
      "ntp_link": [{{ accent_rgb }}],
      "ntp_header": [{{ lighter_background_rgb }}],
      "button_background": [0, 0, 0, 0]
    },
    "tints": {
      "buttons": [-1, -1, -1]
    },
    "properties": {
      "ntp_background_alignment": "bottom"
    }
  }
}
