# Strata's colours, from the current desktop theme. Generated by
# bin/theme-set-templates; bin/theme-set-strata installs it as
# ~/.config/strata/themes/desktop.toml.
name = "Desktop"
background = "{{ background }}"
surface = "{{ lighter_background }}"
text = "{{ foreground }}"
accent = "{{ accent }}"
danger = "{{ red }}"
muted = "{{ selection }}"
highlight = "{{ selection }}"
border = "{{ muted }}"
dim_text = "{{ dark_foreground }}"
syntax_keyword = "{{ magenta }}"
syntax_string = "{{ green }}"
syntax_constant = "{{ orange }}"
syntax_type = "{{ yellow }}"
syntax_preprocessor = "{{ cyan }}"
