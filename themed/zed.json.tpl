{
  "$schema": "https://zed.dev/schema/themes/v0.2.0.json",
  "name": "Desktop",
  "author": "bin/theme-set-templates, from the current desktop theme",
  "themes": [
    {
      "name": "Desktop",
      "appearance": "{{ mode }}",
      "style": {
        "background": "{{ dark_background }}",
        "surface.background": "{{ background }}",
        "elevated_surface.background": "{{ lighter_background }}",
        "border": "{{ mix lighter_background foreground 12% }}",
        "border.variant": "{{ lighter_background }}",
        "border.focused": "{{ accent }}",
        "border.selected": "{{ accent }}",
        "border.transparent": "#00000000",
        "border.disabled": "{{ lighter_background }}",
        "text": "{{ foreground }}",
        "text.muted": "{{ dark_foreground }}",
        "text.placeholder": "{{ mix background foreground 45% }}",
        "text.disabled": "{{ mix background foreground 35% }}",
        "text.accent": "{{ accent }}",
        "icon": "{{ foreground }}",
        "icon.muted": "{{ dark_foreground }}",
        "icon.disabled": "{{ mix background foreground 35% }}",
        "icon.placeholder": "{{ dark_foreground }}",
        "icon.accent": "{{ accent }}",
        "element.background": "{{ lighter_background }}",
        "element.hover": "{{ mix lighter_background foreground 8% }}",
        "element.active": "{{ mix lighter_background foreground 16% }}",
        "element.selected": "{{ selection }}",
        "element.disabled": "{{ lighter_background }}",
        "ghost_element.background": "#00000000",
        "ghost_element.hover": "{{ lighter_background }}",
        "ghost_element.active": "{{ mix lighter_background foreground 10% }}",
        "ghost_element.selected": "{{ selection }}",
        "ghost_element.disabled": "#00000000",
        "drop_target.background": "{{ accent }}33",
        "title_bar.background": "{{ dark_background }}",
        "title_bar.inactive_background": "{{ darker_background }}",
        "toolbar.background": "{{ background }}",
        "tab_bar.background": "{{ dark_background }}",
        "tab.active_background": "{{ background }}",
        "tab.inactive_background": "{{ dark_background }}",
        "status_bar.background": "{{ dark_background }}",
        "panel.background": "{{ dark_background }}",
        "panel.focused_border": "{{ accent }}",
        "pane.focused_border": "{{ accent }}",
        "pane_group.border": "{{ lighter_background }}",
        "search.match_background": "{{ accent }}40",
        "scrollbar.thumb.background": "{{ foreground }}26",
        "scrollbar.thumb.hover_background": "{{ foreground }}40",
        "scrollbar.thumb.border": "#00000000",
        "scrollbar.track.background": "#00000000",
        "scrollbar.track.border": "#00000000",
        "editor.background": "{{ background }}",
        "editor.foreground": "{{ foreground }}",
        "editor.gutter.background": "{{ background }}",
        "editor.subheader.background": "{{ dark_background }}",
        "editor.active_line.background": "{{ lighter_background }}80",
        "editor.highlighted_line.background": "{{ lighter_background }}",
        "editor.line_number": "{{ muted }}",
        "editor.active_line_number": "{{ foreground }}",
        "editor.invisible": "{{ muted }}",
        "editor.wrap_guide": "{{ lighter_background }}",
        "editor.active_wrap_guide": "{{ muted }}",
        "editor.document_highlight.read_background": "{{ accent }}22",
        "editor.document_highlight.write_background": "{{ accent }}33",
        "link_text.hover": "{{ accent }}",
        "terminal.background": "{{ background }}",
        "terminal.foreground": "{{ foreground }}",
        "terminal.bright_foreground": "{{ bright_foreground }}",
        "terminal.dim_foreground": "{{ dark_foreground }}",
        "terminal.ansi.black": "{{ background }}",
        "terminal.ansi.red": "{{ red }}",
        "terminal.ansi.green": "{{ green }}",
        "terminal.ansi.yellow": "{{ yellow }}",
        "terminal.ansi.blue": "{{ blue }}",
        "terminal.ansi.magenta": "{{ magenta }}",
        "terminal.ansi.cyan": "{{ cyan }}",
        "terminal.ansi.white": "{{ foreground }}",
        "terminal.ansi.bright_black": "{{ muted }}",
        "terminal.ansi.bright_red": "{{ bright_red }}",
        "terminal.ansi.bright_green": "{{ bright_green }}",
        "terminal.ansi.bright_yellow": "{{ bright_yellow }}",
        "terminal.ansi.bright_blue": "{{ bright_blue }}",
        "terminal.ansi.bright_magenta": "{{ bright_magenta }}",
        "terminal.ansi.bright_cyan": "{{ bright_cyan }}",
        "terminal.ansi.bright_white": "{{ bright_foreground }}",
        "error": "{{ red }}",
        "error.background": "{{ red }}1a",
        "error.border": "{{ red }}66",
        "warning": "{{ yellow }}",
        "warning.background": "{{ yellow }}1a",
        "warning.border": "{{ yellow }}66",
        "info": "{{ blue }}",
        "info.background": "{{ blue }}1a",
        "info.border": "{{ blue }}66",
        "hint": "{{ dark_foreground }}",
        "hint.background": "{{ lighter_background }}",
        "hint.border": "{{ muted }}",
        "success": "{{ green }}",
        "success.background": "{{ green }}1a",
        "success.border": "{{ green }}66",
        "created": "{{ green }}",
        "created.background": "{{ green }}1a",
        "modified": "{{ yellow }}",
        "modified.background": "{{ yellow }}1a",
        "deleted": "{{ red }}",
        "deleted.background": "{{ red }}1a",
        "conflict": "{{ orange }}",
        "renamed": "{{ blue }}",
        "hidden": "{{ muted }}",
        "ignored": "{{ muted }}",
        "unreachable": "{{ dark_foreground }}",
        "predictive": "{{ muted }}",
        "players": [
          { "cursor": "{{ accent }}", "background": "{{ accent }}", "selection": "{{ accent }}40" },
          { "cursor": "{{ magenta }}", "background": "{{ magenta }}", "selection": "{{ magenta }}33" },
          { "cursor": "{{ green }}", "background": "{{ green }}", "selection": "{{ green }}33" },
          { "cursor": "{{ orange }}", "background": "{{ orange }}", "selection": "{{ orange }}33" }
        ],
        "syntax": {
          "comment": { "color": "{{ dark_foreground }}", "font_style": "italic" },
          "comment.doc": { "color": "{{ dark_foreground }}", "font_style": "italic" },
          "string": { "color": "{{ green }}" },
          "string.escape": { "color": "{{ cyan }}" },
          "string.regex": { "color": "{{ orange }}" },
          "string.special": { "color": "{{ orange }}" },
          "number": { "color": "{{ orange }}" },
          "boolean": { "color": "{{ orange }}" },
          "constant": { "color": "{{ orange }}" },
          "keyword": { "color": "{{ magenta }}" },
          "operator": { "color": "{{ cyan }}" },
          "function": { "color": "{{ blue }}" },
          "function.method": { "color": "{{ blue }}" },
          "constructor": { "color": "{{ yellow }}" },
          "type": { "color": "{{ yellow }}" },
          "enum": { "color": "{{ yellow }}" },
          "variant": { "color": "{{ yellow }}" },
          "variable": { "color": "{{ foreground }}" },
          "variable.special": { "color": "{{ red }}" },
          "property": { "color": "{{ light_foreground }}" },
          "attribute": { "color": "{{ yellow }}" },
          "tag": { "color": "{{ red }}" },
          "label": { "color": "{{ accent }}" },
          "preproc": { "color": "{{ cyan }}" },
          "punctuation": { "color": "{{ dark_foreground }}" },
          "punctuation.bracket": { "color": "{{ dark_foreground }}" },
          "punctuation.delimiter": { "color": "{{ dark_foreground }}" },
          "punctuation.special": { "color": "{{ cyan }}" },
          "title": { "color": "{{ accent }}", "font_weight": 700 },
          "emphasis": { "font_style": "italic" },
          "emphasis.strong": { "font_weight": 700 },
          "link_text": { "color": "{{ accent }}" },
          "link_uri": { "color": "{{ cyan }}" },
          "text.literal": { "color": "{{ green }}" },
          "embedded": { "color": "{{ foreground }}" },
          "hint": { "color": "{{ muted }}" },
          "predictive": { "color": "{{ muted }}", "font_style": "italic" }
        }
      }
    }
  ]
}
