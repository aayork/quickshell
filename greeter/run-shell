#!/bin/sh
# Started by greeter/hyprland.lua. When the login screen exits (it quits
# after handing over to the session), Hyprland goes with it.
CACHE="${AAYORK_GREETER_CACHE:-/var/cache/aayork-greeter}"
rm -f "$CACHE/ready"
quickshell -p "$AAYORK_GREETER_DIR" >"$CACHE/quickshell.log" 2>&1 &
qs=$!

# Watchdog: the screen touches $CACHE/ready once it is drawn. If that has not
# happened in 20 s (a QML error, a hang), stop it so greeter/start falls back.
i=0
while [ $i -lt 20 ] && [ ! -e "$CACHE/ready" ] && kill -0 $qs 2>/dev/null; do
  sleep 1
  i=$((i + 1))
done
[ -e "$CACHE/ready" ] || kill $qs 2>/dev/null

wait $qs && [ -e "$CACHE/ready" ] && touch "$CACHE/ok"
# Lua-config Hyprland: plain `dispatch exit` is an error and left this to the kill below.
hyprctl dispatch 'hl.dsp.exit()' >/dev/null 2>&1
sleep 2
# Still up: stop the compositor greeter/start launched (never any other).
pid=$(cat "$CACHE/hyprland.pid" 2>/dev/null)
[ -n "$pid" ] && kill "$pid" 2>/dev/null
exit 0
