#!/bin/bash

# Set the cursor theme and size everywhere a client reads it

# The Settings overlay's Cursor row and size slider call this. There is no
# single cursor setting on a Hyprland desktop; each kind of client looks in a
# different place, so this writes all of them:
#
#   - Hyprland's own cursor, plus every client that uses cursor-shape-v1
#     (GTK4, Qt 6, Chromium, Firefox, quickshell): hyprctl setcursor.
#   - GTK3 on Wayland, and the settings portal Flatpaks/Electron read: gsettings.
#   - GTK apps without gsettings: gtk-3.0/gtk-4.0 settings.ini.
#   - Xwayland GTK apps, live: xsettingsd's Gtk/CursorThemeSize (SIGHUP).
#   - Other Xwayland apps (Qt xcb, Steam, Wine) go through libXcursor. With
#     xscale, X11 apps render at the X11 scale (2 here) and Xwayland divides
#     the cursor back down, so the Xcursor.size resource is size * x11
#     scale, while the XCURSOR_SIZE environment variable stays at the
#     logical size: toolkits such as Qt multiply it by the scale themselves,
#     so an X11-sized XCURSOR_SIZE would double them.
#     X windows with no cursor of their own show the root window's, which is
#     reset here too. Sizes between the theme's bitmaps get a generated
#     bitmap at exactly that size (see below), so Hyprland and X apps show
#     the same one.
#   - XCURSOR_* for apps started from now on: Hyprland's env (keybinds),
#     the systemd/D-Bus activation env, and session.env, which the shell
#     sources before every launch (Util.execDetached). Apps already running
#     keep the env they started with, so X apps that aren't GTK need a
#     restart to pick up a new size.
#
# The values also go in cursor.lua, which hyprland.lua loads after its own
# environment section, so they survive a reload and the next login.

# Where this shell lives, and its own scripts first on the PATH.
SHELL_ROOT="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
PATH="$SHELL_ROOT/bin:$PATH"

STATE_DIR="$HOME/.local/state/aayork-quickshell"
LUA_FILE="$STATE_DIR/cursor.lua"
ENV_FILE="$STATE_DIR/session.env"
XSETTINGS_FILE="$HOME/.config/xsettingsd/xsettingsd.conf"
XRESOURCES_FILE="$HOME/.Xresources"

usage() {
  echo "Usage: cursor-set <theme> <size>" >&2
  echo "       cursor-set --sizes <theme>" >&2
  exit 1
}

# The scale X11 clients render at in this session: xscale's xwayland:scale as
# Hyprland resolves it (-1 the highest monitor scale rounded up, -2 as it is),
# or, on a Hyprland without it, the highest monitor scale under
# force_zero_scaling and 1 otherwise.
x11_scale() {
  local highest option fzs
  highest=$(hyprctl monitors -j 2>/dev/null | jq -r '[.[].scale] + [1] | max' 2>/dev/null)
  highest=${highest:-1}
  option=$(hyprctl getoption xwayland:scale -j 2>/dev/null | jq -r '.float // empty' 2>/dev/null || true)
  if [[ -n $option ]]; then
    awk -v s="$option" -v h="$highest" 'BEGIN {
      if (s == 0) { print 0; exit }
      if (s < -1.5) { v = h } else if (s < 0) { v = int(h - 0.001); if (v < h - 0.001) v += 1 } else { v = s }
      v = int(v * 120 + 0.5) / 120
      if (v < 1) v = 1
      print v
    }'
    return
  fi
  fzs=$(hyprctl getoption xwayland:force_zero_scaling -j 2>/dev/null | jq -r 'if .bool == true or .int == 1 then 1 else 0 end')
  if [[ $fzs == 1 ]]; then echo "$highest"; else echo 1; fi
}

# --sizes prints the sizes worth offering for a theme, one per line. XCursor
# themes ship a few fixed bitmaps (often 24/36/48/...); a size between them
# snaps to a neighbour, and each kind of client rounds and snaps (or
# rescales) its own way, so the cursor changed size from app to app. Sizes
# offered either land (within a pixel) on a bitmap, or get one generated at
# exactly size * scale, so the compositor and Xwayland agree. A size given
# to cursor-set is snapped to the nearest of these.
cursor_sizes() {
  local scale
  scale=$(hyprctl monitors -j 2>/dev/null | jq -r '[.[].scale] | max // 1' 2>/dev/null)
  THEME=$1 SCALE=${scale:-1} HYPRLAND=1 python3 - <<'EOF'
import os, struct

theme, scale = os.environ["THEME"], float(os.environ["SCALE"] or 1)
home = os.path.expanduser("~")
dirs = [home + "/.local/share/icons", home + "/.icons", "/usr/share/icons"]

def bitmap_sizes(path):
    try:
        with open(path, "rb") as f:
            data = f.read()
    except OSError:
        return set()
    if data[:4] != b"Xcur":
        return set()
    count = struct.unpack_from("<I", data, 12)[0]
    found = set()
    for i in range(count):
        kind, subtype, _ = struct.unpack_from("<III", data, 16 + 12 * i)
        if kind == 0xFFFD0002:
            found.add(subtype)
    return found

found = set()
for d in dirs:
    # Skip copies generated by older versions of this script.
    if os.path.exists(os.path.join(d, theme, ".generated-xcursor")):
        continue
    for name in ("left_ptr", "default", "arrow"):
        found = bitmap_sizes(os.path.join(d, theme, "cursors", name))
        if found:
            break
    if found:
        break

# One size per bitmap: the whole number nearest bitmap / scale. Where the
# bitmap doesn't divide by the scale (36 px at 1.6 -> 22, i.e. 35.2 px) it is
# kept while it lands within a pixel or 4% of the bitmap: every loader still
# picks that bitmap, and one that rescales to the asked-for size is off by
# less than a pixel. Sizes further between bitmaps snap or stretch
# differently from app to app, so they aren't offered.
sizes = set()
for b in found:
    size = round(b / scale)
    if size > 0 and abs(size * scale - b) <= max(1, b * 0.04):
        sizes.add(size)
sizes = sizes or {round(b / scale) for b in found}
# Only the theme's own sizes: generated in-between bitmaps (scaled down from
# a bigger one) look no different from a neighbour at some sizes and soft at
# others. Hyprland also draws its own cursor from a size * ceil(scale) bitmap,
# which cursor-set makes by scaling down; a size whose one would be bigger
# than the theme's largest can't match the X apps' cursor, so it's left out.
if found and os.environ.get("HYPRLAND") == "1":
    ceil = -(-scale // 1)
    sizes = {s for s in sizes if s * ceil <= max(found)} or sizes
print("\n".join(str(s) for s in sorted(s for s in sizes if 8 <= s <= 128)))
EOF
}

if [[ $1 == --sizes ]]; then
  (( $# == 2 )) || usage
  cursor_sizes "$2"
  exit 0
fi

(( $# == 2 )) || usage
theme=$1 size=$2
# Theme names go into Lua strings and sed replacements below.
[[ $theme =~ ^[A-Za-z0-9._+\ -]+$ ]] || usage
[[ $size =~ ^[0-9]+$ ]] || usage
(( size < 12 )) && size=12
(( size > 96 )) && size=96

# Settings calls this on every notch while the size slider is dragged, and a
# run takes a couple of seconds (the theme copy below). Runs go one at a
# time, and one that waited while a newer request came in steps aside for
# it, so only the latest size is applied and runs never trip over each
# other's theme copy.
mkdir -p "$STATE_DIR"
request="$theme $size $$"
printf '%s\n' "$request" >"$STATE_DIR/cursor-set.request"
exec {lock}>"$STATE_DIR/cursor-set.lock"
flock "$lock"
[[ $(cat "$STATE_DIR/cursor-set.request" 2>/dev/null) == "$request" ]] || exit 0

# Only sizes the theme comes in (see cursor_sizes).
size=$(cursor_sizes "$theme" | awk -v s="$size" '
  { d = $1 - s; if (d < 0) d = -d; if (best == "" || d < bd) { best = $1; bd = d } }
  END { print (best == "" ? s : best) }')

x11_scale=$(x11_scale)
[[ $x11_scale == 0 ]] && x11_scale=1
x11_scale=${x11_scale:-1}
x11_size=$(awk -v s="$size" -v x="$x11_scale" 'BEGIN { printf "%d", s * x + 0.5 }')
# The size the compositor draws its own cursor at.
pixel_scale=$(hyprctl monitors -j 2>/dev/null | jq -r '[.[].scale] | max // 1' 2>/dev/null)
pixel_size=$(awk -v s="$size" -v x="${pixel_scale:-1}" 'BEGIN { printf "%d", s * x + 0.5 }')
# Hyprland loads XCursor themes at size * ceil(scale) and draws that bitmap at
# 1 / ceil(scale), so at 1.6 it wants a size*2 bitmap (shown at size*1.6),
# not size*1.6: without an exact one it snaps to a neighbour and its cursor
# no longer matches the X apps' (Xcursor.size = size * x11 scale).
pixel_size="$pixel_size $(awk -v s="$size" -v x="${pixel_scale:-1}" 'BEGIN { c = int(x); if (c < x) c++; printf "%d", s * c }')"

# Sizes between the theme's bitmaps: a copy of the theme goes in
# ~/.local/share/icons (first in every cursor loader's search path, the
# compositor's and Steam's runtime included, so it shadows the installed
# one) with a bitmap scaled down to exactly size * scale. The compositor and
# X apps then all find that exact bitmap instead of snapping to different
# neighbours. The copy holds ONLY the sizes in use: X apps read the logical
# XCURSOR_SIZE and some (Chromium's Steam and Spotify) take a bitmap at
# exactly that size when the theme has one (24, 36, 48... in most themes),
# which the compositor then stretches by the scale into a blurry cursor.
# With only size * scale and the compositor's sizes left, every X app ends
# up on a sharp one. Done before anything below tells a client about the
# new size.
if command -v python3 >/dev/null; then
  THEME=$theme SIZES="$pixel_size $x11_size" python3 - <<'EOF' 2>/dev/null
import os, shutil, struct

theme = os.environ["THEME"]
sizes = sorted({int(n) for n in os.environ["SIZES"].split()})
key = "only " + " ".join(map(str, sizes))
home = os.path.expanduser("~")
dirs = [home + "/.local/share/icons", home + "/.icons", "/usr/share/icons"]
MARK = ".generated-xcursor"
IMAGE = 0xFFFD0002
copy = os.path.join(dirs[0], theme)

def chunks(data):
    # (type, subtype, raw bytes) per chunk; None for anything unexpected.
    if data[:4] != b"Xcur":
        return None
    out = []
    for i in range(struct.unpack_from("<I", data, 12)[0]):
        kind, subtype, pos = struct.unpack_from("<III", data, 16 + 12 * i)
        if kind != IMAGE:
            return None
        width, height = struct.unpack_from("<II", data, pos + 16)
        out.append((kind, subtype, data[pos:pos + 36 + width * height * 4]))
    return out

def taps(src, dst):
    # Per output pixel, the source pixels it covers and how much of each.
    out = []
    for i in range(dst):
        lo, hi = i * src / dst, (i + 1) * src / dst
        cover = [(j, min(hi, j + 1) - max(lo, j)) for j in range(int(lo), min(src, int(hi) + 1))]
        total = sum(k for _, k in cover)
        out.append([(j, k / total) for j, k in cover if k > 0])
    return out

def scaled(raw, nominal, size):
    # Area-average one image chunk down to `size`. Pixels are premultiplied
    # ARGB, so the channels average independently.
    width, height, xhot, yhot, delay = struct.unpack_from("<5I", raw, 16)
    nw = max(1, round(width * size / nominal))
    nh = max(1, round(height * size / nominal))
    pixels, tx, ty = raw[36:], taps(width, nw), taps(height, nh)
    rows = []
    for y in range(height):
        row = pixels[y * width * 4:(y + 1) * width * 4]
        rows.append([sum(row[j * 4 + c] * k for j, k in t) for t in tx for c in range(4)])
    body = bytes(min(255, int(sum(rows[j][x] * k for j, k in t) + 0.5))
                 for t in ty for x in range(nw * 4))
    hot = (min(nw - 1, round(xhot * size / nominal)), min(nh - 1, round(yhot * size / nominal)))
    return struct.pack("<9I", 36, IMAGE, size, 1, nw, nh, *hot, delay) + body

def with_sizes(data):
    parts = chunks(data)
    if not parts:
        return data
    have = {subtype for _, subtype, _ in parts}
    added = []
    for size in sizes:
        bigger = [n for n in have if n > size]
        if size in have or not bigger:
            continue
        # From the nearest larger bitmap: the least detail thrown away.
        nominal = min(bigger)
        added += [(IMAGE, size, scaled(raw, nominal, size)) for _, subtype, raw in parts if subtype == nominal]
    # Keep only the sizes in use (see above), unless none of them exist.
    kept = [p for p in parts + added if p[1] in sizes]
    if not kept:
        return data
    parts = sorted(kept, key=lambda p: p[1])
    out = struct.pack("<4sIII", b"Xcur", 16, 0x10000, len(parts))
    pos = 16 + 12 * len(parts)
    for kind, subtype, raw in parts:
        out += struct.pack("<III", kind, subtype, pos)
        pos += len(raw)
    return out + b"".join(raw for _, _, raw in parts)

def marked(path):
    try:
        with open(os.path.join(path, MARK)) as f:
            return f.read().strip()
    except OSError:
        return None

if marked(copy) == key:
    raise SystemExit

# Copies for an earlier theme. One for this theme stays in place until the
# new one is ready (swapped in at the end), so cursors never fall back to the
# installed theme's sizes while it is built.
if os.path.isdir(dirs[0]):
    for name in os.listdir(dirs[0]):
        path = os.path.join(dirs[0], name)
        if path != copy and (marked(path) is not None or name.endswith((".new", ".old"))):
            shutil.rmtree(path, ignore_errors=True)

source = next((os.path.join(d, theme) for d in dirs
               if os.path.isdir(os.path.join(d, theme, "cursors"))
               and marked(os.path.join(d, theme)) is None), None)
# A theme installed in ~/.local/share/icons itself can't be shadowed.
if not source or source == copy:
    raise SystemExit

bitmaps = set()
for name in ("left_ptr", "default", "arrow"):
    try:
        with open(os.path.join(source, "cursors", name), "rb") as f:
            bitmaps = {subtype for _, subtype, _ in chunks(f.read()) or []}
    except OSError:
        continue
    if bitmaps:
        break
# Nothing to change when the theme already has exactly the sizes in use
# (sizes above its largest bitmap can't be made).
if not bitmaps or bitmaps == {n for n in sizes if n <= max(bitmaps)}:
    raise SystemExit

tmp = copy + ".new"
shutil.rmtree(tmp, ignore_errors=True)
os.makedirs(os.path.join(tmp, "cursors"))
for name in os.listdir(os.path.join(source, "cursors")):
    src, dst = os.path.join(source, "cursors", name), os.path.join(tmp, "cursors", name)
    if os.path.islink(src):
        os.symlink(os.readlink(src), dst)
    elif os.path.isfile(src):
        with open(src, "rb") as f:
            data = f.read()
        with open(dst, "wb") as f:
            f.write(with_sizes(data))
for name in ("index.theme", "cursor.theme"):
    if os.path.isfile(os.path.join(source, name)):
        shutil.copy(os.path.join(source, name), tmp)
with open(os.path.join(tmp, MARK), "w") as f:
    f.write(key)
# Swap: the old copy (if any) moves aside, the new one takes its place.
old = copy + ".old"
shutil.rmtree(old, ignore_errors=True)
if marked(copy) is not None:
    os.rename(copy, old)
os.rename(tmp, copy)
shutil.rmtree(old, ignore_errors=True)
EOF
fi

# The fallback theme for cursor names the chosen theme lacks: libXcursor and
# Chromium (Steam) look in "default", so point it at the chosen theme rather
# than whatever was picked before.
mkdir -p "$HOME/.icons/default"
printf '[Icon Theme]\nInherits=%s\n' "$theme" >"$HOME/.icons/default/index.theme"

# Replace a `key<sep>value` line in a file, or append it when missing.
set_line() {
  local file=$1 key=$2 sep=$3 value=$4
  mkdir -p "${file%/*}"
  touch "$file"
  if grep -q "^${key}${sep}" "$file"; then
    sed -i "s|^${key}${sep}.*|${key}${sep}${value}|" "$file"
  else
    printf '%s%s%s\n' "$key" "$sep" "$value" >>"$file"
  fi
}

mkdir -p "$STATE_DIR"

printf -- '-- Written by cursor-set; loaded from hyprland.lua.\nhl.env("XCURSOR_THEME", "%s")\nhl.env("XCURSOR_SIZE", "%s")\nhl.env("HYPRCURSOR_SIZE", "%s")\n' \
  "$theme" "$size" "$size" >"$LUA_FILE.new" && mv "$LUA_FILE.new" "$LUA_FILE"

printf '# Written by cursor-set; sourced before shell launches.\nexport XCURSOR_THEME=%q\nexport XCURSOR_SIZE=%s\nexport HYPRCURSOR_SIZE=%s\n' \
  "$theme" "$size" "$size" >"$ENV_FILE.new" && mv "$ENV_FILE.new" "$ENV_FILE"

hyprctl setcursor "$theme" "$size" >/dev/null
hyprctl eval "hl.env(\"XCURSOR_THEME\", \"$theme\")
hl.env(\"XCURSOR_SIZE\", \"$size\")
hl.env(\"HYPRCURSOR_SIZE\", \"$size\")" >/dev/null

systemctl --user set-environment XCURSOR_THEME="$theme" XCURSOR_SIZE="$size" HYPRCURSOR_SIZE="$size" 2>/dev/null
dbus-update-activation-environment XCURSOR_THEME="$theme" XCURSOR_SIZE="$size" HYPRCURSOR_SIZE="$size" 2>/dev/null

gsettings set org.gnome.desktop.interface cursor-theme "$theme"
gsettings set org.gnome.desktop.interface cursor-size "$size"

for gtk in gtk-3.0 gtk-4.0; do
  ini="$HOME/.config/$gtk/settings.ini"
  [[ -f $ini ]] || printf '[Settings]\n' >"$ini"
  set_line "$ini" gtk-cursor-theme-name = "$theme"
  set_line "$ini" gtk-cursor-theme-size = "$size"
done

# Every xsettingsd config in play: ours, plus whatever the running xsettingsd
# was started with (xscale settings starts one on ~/.config/xscale/...).
xsettings_files=("$XSETTINGS_FILE")
for pid in $(pgrep -x xsettingsd); do
  conf=$(tr '\0' '\n' <"/proc/$pid/cmdline" 2>/dev/null | awk 'prev == "-c" { print; exit } { prev = $0 }')
  [[ -n $conf && -f $conf && $conf != "$XSETTINGS_FILE" ]] && xsettings_files+=("$conf")
done
for file in "${xsettings_files[@]}"; do
  set_line "$file" Gtk/CursorThemeName ' ' "\"$theme\""
  set_line "$file" Gtk/CursorThemeSize ' ' "$size"
done
pkill -HUP -x xsettingsd 2>/dev/null
# xscale's own Xresources, merged again whenever `xscale settings` runs.
if [[ -f $HOME/.config/xscale/Xresources ]]; then
  set_line "$HOME/.config/xscale/Xresources" Xcursor.theme ': ' "$theme"
  set_line "$HOME/.config/xscale/Xresources" Xcursor.size ': ' "$x11_size"
fi

set_line "$XRESOURCES_FILE" Xcursor.theme ': ' "$theme"
set_line "$XRESOURCES_FILE" Xcursor.size ': ' "$x11_size"
command -v xrdb >/dev/null && xrdb -merge "$XRESOURCES_FILE" 2>/dev/null

# Xwayland windows that never set a cursor of their own show the root
# window's; bin/x-root-cursor redefines it at the new size (also run at login).
[[ -n $DISPLAY ]] && "$(dirname "$(readlink -f "$0")")/x-root-cursor" "$theme" "$x11_size"


# Keep the login screen in step (no-op until bin/greeter-install has run).
"$(dirname "$(readlink -f "$0")")/greeter-sync" --quiet >/dev/null 2>&1 &

exit 0
