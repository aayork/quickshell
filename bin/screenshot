#!/bin/bash
set -uo pipefail

# Takes a screenshot: region, smart (drag, or click a window), or fullscreen.
# The picture is saved to ~/Pictures/Screenshots and copied to the clipboard.
#
# Bound straight from hyprland.lua, never run through a Quickshell Process:
# that breaks hyprpicker's screen freeze and cuts slurp's first click short.
#
# The capture part is VibeShot's capture.sh. Its editor is not ported yet, so
# for now the result goes to disk and the clipboard instead.

# Fixed PATH so grim/slurp/jq/hyprctl resolve to the system binaries.
export PATH=/usr/bin:/bin
BIN="$(dirname "$(readlink -f "$0")")"

MODE="${1:-smart}"
SAVE_DIR="${XDG_PICTURES_DIR:-$HOME/Pictures}/Screenshots"

# A second press while a selection is in progress cancels it.
pkill slurp && exit 0

NO_HW_CURSORS=$(hyprctl getoption cursor:no_hardware_cursors -j | jq '.int')

set_no_hw_cursors() {
  hyprctl eval "hl.config({ cursor = { no_hardware_cursors = $1 } })" &>/dev/null ||
    hyprctl keyword cursor:no_hardware_cursors "$1" &>/dev/null
}

cleanup() {
  [[ -n "${FREEZE_PID:-}" ]] && kill "$FREEZE_PID" 2>/dev/null
  set_no_hw_cursors "$NO_HW_CURSORS"
}
trap cleanup EXIT

set_no_hw_cursors 0
{ read -r FREEZE_PID; read -r SELECTION; } < <("$BIN/capture-region" "$MODE" --keep-freeze)

[[ -z "$SELECTION" ]] && exit 1

mkdir -p "$SAVE_DIR"
FILE="$SAVE_DIR/Screenshot $(date '+%Y-%m-%d %H-%M-%S').png"
grim -g "$SELECTION" "$FILE" || { rm -f "$FILE"; exit 1; }
wl-copy --type image/png <"$FILE"
notify-send -a Screenshot -i "$FILE" "Screenshot copied" "$(basename "$FILE")"
