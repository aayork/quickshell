#!/bin/bash

# Unblock and restart the Wi-Fi service.

# Where this shell lives, with its own scripts first on the PATH.
SHELL_ROOT="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
PATH="$SHELL_ROOT/bin:$SHELL_ROOT/launcher/scripts:$PATH"

echo -e "Unblocking wifi...\n"

rfkill unblock wifi
nmcli networking on
nmcli radio wifi on
nmcli device wifi rescan 2>/dev/null || true
rfkill list wifi
