#!/bin/bash

# Show current theme

# Where this shell lives, and its own scripts first on the PATH.
SHELL_ROOT="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
PATH="$SHELL_ROOT/bin:$PATH"

THEME_NAME_PATH="$HOME/.local/state/aayork-quickshell/current/theme.name"

if [[ -f $THEME_NAME_PATH ]]; then
  sed -E 's/(^|-)([a-z])/\1\u\2/g; s/-/ /g' "$THEME_NAME_PATH"
else
  echo "Unknown"
fi
