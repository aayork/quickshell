#!/bin/bash

# Copy a file to the clipboard and paste it

# Where this shell lives, with its own scripts first on the PATH.
SHELL_ROOT="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
PATH="$SHELL_ROOT/bin:$SHELL_ROOT/launcher/scripts:$PATH"

copy_only=false

if [[ ${1:-} == "--copy-only" ]]; then
  copy_only=true
  shift
fi

mime=${1:-}
path=${2:-}

if [[ -z $mime || -z $path ]]; then
  echo "Usage: clipboard-paste-file [--copy-only] <mime-type> <path>" >&2
  exit 1
fi

[[ -r $path ]] || exit 1

wl-copy --type "$mime" < "$path"

if [[ $copy_only == "true" ]]; then
  exit
fi

sleep 0.15
wtype -M shift -k Insert -m shift 2>/dev/null || true
