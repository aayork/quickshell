#!/bin/bash

# Launch a TUI command in the default terminal with the shell's window class

# Where this shell lives, with its own scripts first on the PATH.
SHELL_ROOT="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
PATH="$SHELL_ROOT/bin:$SHELL_ROOT/launcher/scripts:$PATH"

if [[ ${1:-} == --app-id=* ]]; then
  APP_ID="${1#--app-id=}"
  shift
else
  APP_ID="org.aayork.$(basename $1)"
fi

# uwsm-app exists only inside a UWSM session; elsewhere launch directly.
command -v uwsm-app >/dev/null 2>&1 || exec setsid xdg-terminal-exec --app-id=$APP_ID -e "$1" "${@:2}"
exec setsid uwsm-app -- xdg-terminal-exec --app-id=$APP_ID -e "$1" "${@:2}"
