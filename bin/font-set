#!/bin/bash

# Sets the system monospace font: the terminals' own configs, then fontconfig,
# which is what the shell and everything else asking for "monospace" reads.

font_name="${1:-}"
[[ -n $font_name ]] || { echo "Usage: font-set <font-name>" >&2; exit 1; }

if ! fc-list | grep -Fqi -- "$font_name"; then
  echo "Font '$font_name' not found."
  exit 1
fi

if [[ -f ~/.config/alacritty/alacritty.toml ]]; then
  sed -i "s/family = \".*\"/family = \"$font_name\"/g" ~/.config/alacritty/alacritty.toml
fi

if [[ -f ~/.config/kitty/kitty.conf ]] || command -v kitty >/dev/null; then
  mkdir -p ~/.config/kitty
  if grep -qE '^[[:space:]]*font_family[[:space:]]+' ~/.config/kitty/kitty.conf 2>/dev/null; then
    kitty_font_name=$(printf '%s' "$font_name" | sed 's/[\\&/]/\\&/g')
    sed --follow-symlinks -i -E "s/^[[:space:]]*font_family[[:space:]]+.*/font_family $kitty_font_name/" ~/.config/kitty/kitty.conf
  else
    printf '\nfont_family %s\n' "$font_name" >>~/.config/kitty/kitty.conf
  fi
  pkill -USR1 kitty
fi

# Ghostty 1.2+ prefers config.ghostty; older installs use config.
for ghostty_config in ~/.config/ghostty/config.ghostty ~/.config/ghostty/config; do
  [[ -f $ghostty_config ]] || continue
  sed -i "s/font-family = \".*\"/font-family = \"$font_name\"/g" "$ghostty_config"
  pkill -SIGUSR2 ghostty
done

if [[ -f ~/.config/foot/foot.ini ]]; then
  sed -i "s/^font=.*/font=$font_name:size=9/g" ~/.config/foot/foot.ini
fi

# fontconfig is the canonical source of truth — the shell, Qt apps,
# and anything resolving "monospace" all read from here. This file is loaded
# after the package-owned default, and prepend_first puts the chosen family at
# the head of the list so it wins over the family that default prefers.
fontconfig_file="$HOME/.config/fontconfig/fonts.conf"
mkdir -p "$(dirname "$fontconfig_file")"
cat >"$fontconfig_file" <<XML
<?xml version="1.0"?>
<!DOCTYPE fontconfig SYSTEM "fonts.dtd">
<fontconfig>
  <match target="pattern">
    <test name="family" qual="any">
      <string>monospace</string>
    </test>
    <edit name="family" mode="prepend_first" binding="strong">
      <string>$font_name</string>
    </edit>
  </match>
</fontconfig>
XML

# Keep the login screen in step (no-op until bin/greeter-install has run).
"$(dirname "$(readlink -f "$0")")/greeter-sync" --quiet >/dev/null 2>&1 &

# Qt reads fontconfig once at startup, so the shell has to start again.
"$(dirname "$(readlink -f "$0")")/restart"

pgrep -x ghostty >/dev/null && notify-send -a Settings "Font changed" "Restart Ghostty to see it there"
exit 0
