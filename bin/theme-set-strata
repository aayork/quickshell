#!/bin/bash

# Give the Strata file manager the current theme.
#
# The template engine has already written strata.toml; this installs it as
# one of Strata's own custom themes, "desktop", and selects it. Strata reads
# its themes when it starts, so a window that is already open keeps its
# colours until Strata is next launched.

theme="$HOME/.local/state/aayork-quickshell/current/theme/strata.toml"
config="${XDG_CONFIG_HOME:-$HOME/.config}/strata"
settings="$config/settings.toml"

[[ -f $theme && -d $config ]] || exit 0

mkdir -p "$config/themes"
cp "$theme" "$config/themes/desktop.toml"

# Select it, once. Both keys sit at the top level of settings.toml.
[[ -f $settings ]] || exit 0
if ! grep -qx 'theme = "desktop"' "$settings" || ! grep -qx 'mode = "theme"' "$settings"; then
  sed -i -E 's/^mode = .*/mode = "theme"/; s/^theme = .*/theme = "desktop"/' "$settings"
fi
