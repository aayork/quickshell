#!/bin/bash

# Restarts the shell. Hyprland starts the new one, so it gets the session's
# environment and outlives whatever called this.
DIR="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)"

hyprctl dispatch "hl.dsp.exec_cmd(\"sh -c 'quickshell kill -p $DIR; exec systemd-cat -t aayork-quickshell quickshell -p $DIR'\")" >/dev/null
