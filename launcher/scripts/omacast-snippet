#!/bin/bash
# Emits JSON rows for Omacast's `snip:` keyword: text you keep retyping,
# expanded into the clipboard.
#
#   snip:           every snippet
#   snip:sig        the ones whose name or text matches
#
# Snippets live in ~/.config/aayork-quickshell/omacast-snippets.json, a flat object of
# name to text:
#
#   { "sig": "Luiz\nhttps://nkz.md", "addr": "..." }
#
# No file, or a file with nothing in it, is one row that says so and whose
# Enter writes a starter file and opens it in the editor. The keyword used to
# be hidden behind a `when` until the file existed, but All Commands lists it
# regardless, and a keyword that answers nothing reads as a broken one.
#
# A row carries the snippet's text as `text`, plus how many lines and characters
# it is. The name is a label on that text, not the subject of the row: you named
# it, so you know what it is called and not what is in it.

# Where this shell lives, with its own scripts first on the PATH.
SHELL_ROOT="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/../.." && pwd)"
PATH="$SHELL_ROOT/bin:$SHELL_ROOT/launcher/scripts:$PATH"

set -uo pipefail

query="${1:-}"
SNIPPETS="${XDG_CONFIG_HOME:-$HOME/.config}/aayork-quickshell/omacast-snippets.json"

edit="omacast_f=$(printf '%q' "$SNIPPETS"); if command -v launch-editor >/dev/null; then launch-editor \"\$omacast_f\"; else xdg-open \"\$omacast_f\"; fi"

usable() {
  [[ -f $SNIPPETS ]] && jq -e 'type == "object" and any(.[]; type == "string" and . != "")' "$SNIPPETS" >/dev/null 2>&1
}

if ! usable; then
  starter='{\n  "shrug": "¯\\\\_(ツ)_/¯",\n  "sig": "Best,\\nYour Name"\n}\n'
  create="[[ -s $(printf '%q' "$SNIPPETS") ]] || printf '$starter' >$(printf '%q' "$SNIPPETS"); $edit"
  jq -cn --arg e "$create" --arg f "${SNIPPETS/#$HOME/\~}" \
    '("Enter creates " + $f + " with two examples and opens it in your editor.\n\nIt is a flat object of name to text:\n\n  { \"sig\": \"Best,\\nYour Name\" }") as $text
     | { id: "snip-new", title: "No snippets yet", subtitle: "Enter creates the snippets file",
         preview: $text, text: $text, lines: 5, chars: ($text | length),
         exec: $e, score: 90000,
         actions: [{ title: "Create Snippets File", shortcut: "↵", exec: $e }] }'
  exit 0
fi

jq -c --arg q "${query,,}" --arg edit "$edit" '
  # A hand-edited file is a file that is sometimes mid-edit. Anything that is
  # not an object of strings is skipped rather than turned into a broken row.
  if type != "object" then empty else
    [ to_entries[]
      | select((.value | type) == "string" and .value != "")
      | select($q == ""
               or (.key | ascii_downcase | contains($q))
               or (.value | ascii_downcase | contains($q)))
    ]
    | to_entries[]
    | .key as $i
    | .value
    | ("printf %s " + (.value | @sh) + " | wl-copy") as $copy
    | (.value | split("\n")) as $lines
    | {
        id: .key,
        title: .key,
        # Newlines in a one-line row read as missing text, so the subtitle
        # shows the shape of the snippet rather than only its first line.
        subtitle: (.value | gsub("\\s+"; " ") | .[0:110]),
        preview: .value,
        # What the `snippets` view actually draws. The name is the one thing
        # you already know, so the text goes across whole, newlines and all,
        # and the view lays it out as the text it is rather than as a title.
        text: .value,
        lines: ($lines | length),
        chars: (.value | length),
        exec: $copy,
        score: (90000 - ($i * 100)),
        actions: [
          { title: "Copy Snippet", shortcut: "↵", exec: $copy },
          # The launcher has to be gone before the keystrokes are sent, or the
          # window that gets typed into is the search box.
          { title: "Type Into Window", exec: ("sleep 0.2; wtype " + (.value | @sh)) },
          { title: "Copy Name", exec: ("printf %s " + (.key | @sh) + " | wl-copy") },
          { title: "Edit Snippets File", exec: $edit }
        ]
      }
  end' "$SNIPPETS" 2>/dev/null

exit 0
